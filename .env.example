# Core (required)
# On Railway: set DATABASE_URL to a Variable Reference → ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway
JWT_SECRET=change-me-long-random
PWD_SALT=change-me-long-random
INIT_SECRET=change-me-init-secret

# Public URL of this Railway web service (set after first deploy / domain)
APP_BASE_URL=https://your-service.up.railway.app
PORT=3000

# Email reminders (optional; job no-ops if missing)
RESEND_API_KEY=
RESEND_FROM=deco-production <noreply@your-verified-domain.com>
REMINDER_EMAILS=
CRON_SECRET=change-me-long-random

# cron-worker service only (same CRON_SECRET / APP_BASE_URL as web)
# CRON_EXPR=0 9 * * *
# CRON_TZ=Asia/Hong_Kong
# RUN_ON_START=false

# WhatsApp Cloud API (optional)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ALLOWED_PHONES=
# WHATSAPP_USER_MAP=
# WHATSAPP_REMINDER_PHONES=

# OCR (optional)
# OCR_ENABLED=false
# OCR_API_KEY=
# OCR_MODEL=
# OCR_API_BASE_URL=

# Project AI framework (optional; falls back to OCR_API_KEY / local mock)
# PROJECT_AI_API_KEY=
# PROJECT_AI_MODEL=gpt-4.1-mini
# PROJECT_AI_API_BASE_URL=
# PROJECT_AI_ALLOW_MOCK=true
# PROJECT_AI_TIMEOUT_MS=45000
